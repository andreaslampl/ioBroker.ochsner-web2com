{
  "common": {
    "name": "ochsner-web2com",
    "version": "0.1.3",
    "news": {
      "0.1.3": {
        "en": "Address may also be the full URL as in Node-RED (http://…/ws)",
        "de": "Adresse darf auch die ganze URL wie in Node-RED sein (http://…/ws)"
      },
      "0.1.2": {
        "en": "Login rejected: the log shows which authentication the web2com asks for",
        "de": "Anmeldung abgelehnt: das Log zeigt, welche Anmeldung das web2com verlangt"
      },
      "0.1.1": {
        "en": "\"Read OID\" lists the whole group from that OID on, with names (to find more data points, e.g. cooling)",
        "de": "„OID lesen“ zeigt die ganze Gruppe ab der OID mit Namen (zum Finden weiterer Datenpunkte, z. B. Kühlen)"
      },
      "0.1.0": {
        "en": "First version: data points of the Ochsner web2com (read and write), forwarding to KNX states",
        "de": "Erste Version: Datenpunkte des Ochsner web2com (lesen und schreiben), Weiterleitung an KNX-Datenpunkte"
      }
    },
    "titleLang": {
      "en": "Ochsner web2com",
      "de": "Ochsner web2com"
    },
    "desc": {
      "en": "Ochsner heat pumps via the local web2com gateway: read values, switch operating modes and set points",
      "de": "Ochsner-Wärmepumpen über das lokale web2com-Gateway: Werte lesen, Betriebsarten und Sollwerte schreiben"
    },
    "authors": [
      "andreaslampl"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "icon": "ochsner-web2com.png",
    "extIcon": "https://raw.githubusercontent.com/andreaslampl/ioBroker.ochsner-web2com/main/admin/ochsner-web2com.png",
    "readme": "https://github.com/andreaslampl/ioBroker.ochsner-web2com/blob/main/README.md",
    "enabled": true,
    "type": "climate-control",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ],
    "tier": 2
  },
